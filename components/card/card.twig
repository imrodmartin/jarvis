{#
/**
 * @file
 * Jarvis card SDC: four image layouts via the `layout` prop.
 */
#}
{# Alt text: Decorative wins (empty alt); else the per-placement override when
   it has text; else the media item's alt. #}
{% set img_alt = decorative|default(false) ? '' : (alt_override|default(false) and alt_text|default('')|trim ? alt_text|trim : image.alt|default('')) %}
{% import '@jarvis/jarvis-url.html.twig' as safe %}
{% set link_href = safe.url(link_href|default('')) %}
{% set space = include('@jarvis/jarvis-spacing.html.twig') %}
{# `layout` was called `variant` before Jarvis 4.0. Drupal core reserves that name
   for its own component variants and injects an empty `variant` into every
   component render array, which failed this prop's enum check for any PHP
   caller that left it out. The old name is still read here, so a template
   that includes this component with `variant: ...` keeps its look. #}
{% set layout = layout|default(variant|default('image-top')) %}
{# ADA (WCAG 1.3.1): heading level is a prop so cards can slot into the page's
   heading outline without skipping levels. Visual size stays .h4 regardless. #}
{% set h = heading_level|default('h3') %}
{% set has_image = image.src is defined and image.src %}
{# ADA (WCAG 2.4.4): a row of identical "Read more" buttons is ambiguous out of
   context, so each one carries its card's title for screen readers. #}
{% set link_label %}{{ link_text }}{% if title %}<span class="visually-hidden">: {{ title }}</span>{% endif %}{% endset %}
{# The title links to the card's URL when asked, so the obvious target works.
   text-reset keeps the heading's color on every variant, including light text
   over a background image; Bootstrap's link-underline utilities add an
   underline on hover only. #}
{% set title_html %}{% if title_link|default(false) and link_href %}<a href="{{ link_href }}" class="text-reset text-decoration-underline link-underline link-underline-opacity-0 link-underline-opacity-100-hover">{{ title }}</a>{% else %}{{ title }}{% endif %}{% endset %}
{% set date_line %}{% if date|default('') %}<p class="jarvis-card__date small mb-2"><time datetime="{{ date }}">{{ date|date('F j, Y') }}</time></p>{% endif %}{% endset %}
{% set text_color = text_color|default('light') %}
{# Light text gets a black overlay, black text a white one — the same split the
   column components use. Black text used to force the overlay to 0 and sit on
   the bare photo, which is unreadable over a dark image. #}
{% set overlay = overlay|default(40) %}
{% set overlay_light = text_color == 'black' %}
{# One class for all four variants — the lift and the darkening are pure CSS
   (see card.css), so nothing else in here needs to know about it. #}
{% set hover_class = hover|default(false) ? ' jarvis-card--hover' : '' %}
{% set base = 'jarvis-card card h-100 jarvis-card--' ~ layout ~ hover_class ~ ' ' ~ space %}
{% if layout == 'background' %}
  <div class="{{ base }} jarvis-card--text-{{ text_color }} position-relative overflow-hidden border-0"{% if has_image %} style="background-image: url('{{ image.src }}');"{% endif %}>
    {# The author's value is a floor; jarvis_overlay_alpha samples the image
       server-side and raises it to whatever WCAG AA needs. #}
    {% if has_image %}<div class="jarvis-bg__overlay{{ overlay_light ? ' jarvis-bg__overlay--light' : '' }}" style="opacity: {{ image.src|jarvis_overlay_alpha(overlay_light, overlay / 100) }};" aria-hidden="true"></div>{% endif %}
    <div class="card-img-overlay d-flex flex-column justify-content-end position-relative">
      {% if title %}<{{ h }} class="card-title h4">{{ title_html }}</{{ h }}>{% endif %}{{ date_line }}
      {% if body %}<div class="card-text">{{ body|raw }}</div>{% endif %}
      {% if link_text and link_href %}<a href="{{ link_href }}" class="btn btn-light btn-sm mt-2 align-self-start">{{ link_label }}</a>{% endif %}
    </div>
  </div>
{% elseif layout == 'image-left' or layout == 'image-right' %}
  <div class="{{ base }}">
    <div class="row g-0 {{ layout == 'image-right' ? 'flex-md-row-reverse' : '' }}">
      {% if has_image %}
        <div class="col-md-5">
          <img src="{{ image.src }}" alt="{{ img_alt }}" class="jarvis-card__img jarvis-card__img--side w-100 h-100">
        </div>
      {% endif %}
      <div class="{{ has_image ? 'col-md-7' : 'col-12' }}">
        <div class="card-body">
          {% if title %}<{{ h }} class="card-title h4">{{ title_html }}</{{ h }}>{% endif %}{{ date_line }}
          {% if body %}<div class="card-text">{{ body|raw }}</div>{% endif %}
          {% if link_text and link_href %}<a href="{{ link_href }}" class="btn btn-primary btn-sm mt-2">{{ link_label }}</a>{% endif %}
        </div>
      </div>
    </div>
  </div>
{% else %}
  <div class="{{ base }}">
    {% if has_image %}<img src="{{ image.src }}" alt="{{ img_alt }}" class="card-img-top jarvis-card__img">{% endif %}
    <div class="card-body">
      {% if title %}<{{ h }} class="card-title h4">{{ title_html }}</{{ h }}>{% endif %}{{ date_line }}
      {% if body %}<div class="card-text">{{ body|raw }}</div>{% endif %}
      {% if link_text and link_href %}<a href="{{ link_href }}" class="btn btn-primary btn-sm mt-2">{{ link_label }}</a>{% endif %}
    </div>
  </div>
{% endif %}
