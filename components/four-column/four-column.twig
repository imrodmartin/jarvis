{#
/**
 * @file
 * Jarvis 4-column layout. col-12 mobile -> stack; col-sm-6 tablet -> 2-up;
 * col-lg-3 desktop -> 4-up. Everything placed inside wraps at each breakpoint.
 *
 * Wrapper, background resolution, ADA text-colour matrix and overlay live in
 * the shared shell — see @jarvis/jarvis-columns-shell.html.twig.
 */
#}
{# Per-column alignment. `start` maps to an empty string on purpose: a
   column with the default alignment carries no text-* class, so it
   inherits instead of forcing `text-align: left !important` onto
   everything inside it — including a nested column section. #}
{% set align_classes = { start: '', center: 'text-center', end: 'text-end' } %}
{% embed '@jarvis/jarvis-columns-shell.html.twig' with { count: 4 } %}
  {% block columns %}
    <div class="col-12 col-sm-6 col-lg-3 {{ align_classes[align_first|default('start')] }}">
      {{ first }}
    </div>
    <div class="col-12 col-sm-6 col-lg-3 {{ align_classes[align_second|default('start')] }}">
      {{ second }}
    </div>
    <div class="col-12 col-sm-6 col-lg-3 {{ align_classes[align_third|default('start')] }}">
      {{ third }}
    </div>
    <div class="col-12 col-sm-6 col-lg-3 {{ align_classes[align_fourth|default('start')] }}">
      {{ fourth }}
    </div>
  {% endblock %}
{% endembed %}
