{#
/**
 * @file
 * Jarvis stat card SDC — centered icon, big number, description.
 */
#}
{# Alt text: Decorative wins (empty alt); else the per-placement override when
   it has text; else the media item's alt. #}
{% set img_alt = decorative|default(false) ? '' : (alt_override|default(false) and alt_text|default('')|trim ? alt_text|trim : icon.alt|default('')) %}
{% import '@jarvis/jarvis-spacing.html.twig' as jarvis %}
{% set space = jarvis.classes(padding|default('none'), padding_size|default('medium'), margin|default('none'), margin_size|default('medium'), (vertical_padding is defined ? vertical_padding : false)) %}
{% set has_icon = icon.src is defined and icon.src %}
<div class="jarvis-stat text-center {{ space }}">
  {# alt|default('') — the media picker omits the key entirely when no alt text
     is set, which is a hard error under strict_variables. Empty alt is also the
     right default for an icon that only decorates the number below it. #}
  {% if has_icon %}<img src="{{ icon.src }}" alt="{{ img_alt }}" class="jarvis-stat__icon mb-3">{% endif %}
  {# Custom colour classes (not Bootstrap text-*): overrides.css holds the ADA
     matrix that falls back to the section's safe text colour when the pick
     can't pass WCAG on the surrounding background. #}
  {% if title %}<div class="jarvis-stat__number jarvis-stat__number--{{ number_color|default('primary') }}"{% if count_up %} data-count-up{% endif %}>{{ title }}</div>{% endif %}
  {% if body %}<div class="jarvis-stat__body">{{ body|raw }}</div>{% endif %}
</div>
