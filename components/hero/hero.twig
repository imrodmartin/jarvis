{#
/**
 * @file
 * Jarvis hero banner SDC.
 */
#}
{% import '@jarvis/jarvis-spacing.html.twig' as jarvis %}
{% import '@jarvis/jarvis-url.html.twig' as safe %}
{% set cta_href = safe.url(cta_href|default('')) %}
{% set space = jarvis.classes(padding|default('none'), padding_size|default('medium'), margin|default('none'), margin_size|default('medium'), (vertical_padding is defined ? vertical_padding : false)) %}
{% set align = align|default('center') %}
{% set align_class = { start: 'text-start', center: 'text-center', end: 'text-end' }[align] %}
{% set justify_class = { start: 'justify-content-start', center: 'justify-content-center', end: 'justify-content-end' }[align] %}
{% set has_image = image.src is defined and image.src %}
{% set text_color = text_color|default('light') %}
{# Light text gets a black overlay, dark text a white one — the same split the
   column components use. Dark text used to force the overlay to 0 and sit on
   the bare photo, which is unreadable over a dark image. #}
{% set overlay = overlay|default(40) %}
{% set overlay_light = text_color == 'dark' %}
<section class="jarvis-hero jarvis-hero--text-{{ text_color }} position-relative d-flex align-items-center {{ align_class }} {{ space }}"{% if has_image %} style="background-image: url('{{ image.src }}');"{% endif %}>
  {% if has_image %}
    {# opacity is the author's floor; jarvis_overlay_alpha samples the image
       server-side and raises it until the text clears WCAG AA, so the value is
       already right on first paint. #}
    <div class="jarvis-hero__overlay{{ overlay_light ? ' jarvis-bg__overlay--light' : '' }}" style="opacity: {{ image.src|jarvis_overlay_alpha(overlay_light, overlay / 100) }};" aria-hidden="true"></div>
  {% endif %}
  <div class="container position-relative jarvis-hero__inner py-5">
    <div class="row {{ justify_class }}">
      <div class="jarvis-hero__content">
        {% set h = heading_level|default('h1') %}
        {# No display-* class: it pins one size regardless of {{ h }}, so the
           heading_level prop changed the tag but never the size. Sizing lives
           in hero.css, keyed off the tag. #}
        {% if heading %}<{{ h }} class="jarvis-hero__heading fw-bold mb-3">{{ heading }}</{{ h }}>{% endif %}
        {% if subheading %}<p class="jarvis-hero__subheading lead mb-4">{{ subheading }}</p>{% endif %}
        {% if cta_text and cta_href %}<a href="{{ cta_href }}" class="btn btn-primary btn-lg">{{ cta_text }}</a>{% endif %}
      </div>
    </div>
  </div>
</section>
