{#
/**
 * @file
 * Jarvis video SDC — iframe embed or native <video> for file URLs.
 */
#}
{% import '@jarvis/jarvis-spacing.html.twig' as jarvis %}
{% set space = jarvis.classes(padding|default('none'), padding_size|default('medium'), margin|default('none'), margin_size|default('medium'), (vertical_padding is defined ? vertical_padding : true)) %}
{% set aspect = aspect|default('16x9') %}
{% set ratio_class = { '16x9': 'ratio-16x9', '4x3': 'ratio-4x3', '21x9': 'ratio-21x9' }[aspect] %}
{% set container = full_width ? 'jarvis-video jarvis-video--full' : 'jarvis-video container' %}
{# Watch/share URLs are normalised to embed URLs so any paste works. Shared with
   video-with-sidebar — see @jarvis/jarvis-video.html.twig. #}
{% import '@jarvis/jarvis-video.html.twig' as video %}
{% set is_file = video.is_file(video_url) is not empty %}
{% set embed_url = video.embed_url(video_url) %}
<div class="{{ container }} {{ space }}">
  {% if video_url %}
    <div class="ratio {{ ratio_class }}">
      {% if is_file %}
        {# Autoplay implies muted — browsers block unmuted autoplay. #}
        <video controls preload="metadata"{{ autoplay ? ' autoplay loop playsinline' : '' }}{{ (muted or autoplay) ? ' muted' : '' }}>
          <source src="{{ video_url }}">
          {# ADA (WCAG 1.2.2): captions track for the native player. #}
          {% if captions_url %}<track kind="captions" src="{{ captions_url }}" srclang="{{ captions_lang|default('en') }}" label="{{ 'Captions'|t }}" default>{% endif %}
        </video>
      {% else %}
        <iframe src="{{ embed_url }}" title="{{ title|default('Video'|t) }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
      {% endif %}
    </div>
  {% endif %}
</div>
