{#
/**
 * @file
 * Jarvis button SDC. Bootstrap button rendered as a link.
 */
#}
{% import '@jarvis/jarvis-url.html.twig' as safe %}
{% set href = safe.url(href|default('')) %}
{# `style` was called `variant` before Jarvis 4.0. Drupal core reserves that name
   for its own component variants and injects an empty `variant` into every
   component render array, which failed this prop's enum check for any PHP
   caller that left it out. The old name is still read here, so a template
   that includes this component with `variant: ...` keeps its look. #}
{% set style = style|default(variant|default('primary')) %}
{% set size = size|default('medium') %}
{% set size_class = { small: 'btn-sm', medium: '', large: 'btn-lg' }[size] %}
{% if text %}
  {# ADA: no dead href="#" when the URL is empty; screen readers are told when
     the link leaves the tab (WCAG 3.2 advisory). #}
  <a{% if href %} href="{{ href }}"{% endif %} class="btn btn-{{ style }} {{ size_class }}"{% if new_tab|default(false) %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ text }}{% if new_tab|default(false) %}<span class="visually-hidden"> {{ '(opens in new tab)'|t }}</span>{% endif %}</a>
{% endif %}
