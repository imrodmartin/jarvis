{#
/**
 * @file
 * Jarvis 3-column layout. col-12 mobile -> stack; col-sm-6 tablet -> 2-up;
 * col-lg-4 desktop -> 3-up. Everything placed inside wraps at each breakpoint.
 *
 * Wrapper, background resolution, ADA text-colour matrix and overlay live in
 * the shared shell — see @jarvis/jarvis-columns-shell.html.twig.
 */
#}
{% set cols = {
  even: ['col-lg-4', 'col-lg-4', 'col-lg-4'],
  'wide-first': ['col-lg-6', 'col-lg-3', 'col-lg-3'],
  'wide-middle': ['col-lg-3', 'col-lg-6', 'col-lg-3'],
  'wide-last': ['col-lg-3', 'col-lg-3', 'col-lg-6'],
}[ratio|default('even')] %}
{# Per-column alignment. `start` maps to an empty string on purpose: a
   column with the default alignment carries no text-* class, so it
   inherits instead of forcing `text-align: left !important` onto
   everything inside it — including a nested column section. #}
{% set align_classes = { start: '', center: 'text-center', end: 'text-end' } %}
{% embed '@jarvis/jarvis-columns-shell.html.twig' with { count: 3 } %}
  {% block columns %}
    <div class="col-12 col-sm-6 {{ cols[0] }} {{ align_classes[align_first|default('start')] }}">
      {{ first }}
    </div>
    <div class="col-12 col-sm-6 {{ cols[1] }} {{ align_classes[align_second|default('start')] }}">
      {{ second }}
    </div>
    <div class="col-12 col-sm-6 {{ cols[2] }} {{ align_classes[align_third|default('start')] }}">
      {{ third }}
    </div>
  {% endblock %}
{% endembed %}
