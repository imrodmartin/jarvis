{#
/**
 * @file
 * Jarvis 3-column layout. col-12 mobile -> stack; col-sm-6 tablet -> 2-up;
 * col-lg-4 desktop -> 3-up. Everything placed inside wraps at each breakpoint.
 *
 * Wrapper, background resolution, ADA text-colour matrix and overlay live in
 * the shared shell — see @jarvis/jarvis-columns-shell.html.twig.
 */
#}
{% embed '@jarvis/jarvis-columns-shell.html.twig' with { count: 3 } %}
  {% block columns %}
    <div class="col-12 col-sm-6 col-lg-4">
      {{ first }}
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
      {{ second }}
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
      {{ third }}
    </div>
  {% endblock %}
{% endembed %}
