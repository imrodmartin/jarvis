{#
/**
 * @file
 * Jarvis 1-column layout. Bootstrap row so it composes with the grid.
 *
 * Wrapper, background resolution, ADA text-colour matrix and overlay live in
 * the shared shell — see @jarvis/jarvis-columns-shell.html.twig.
 */
#}
{% embed '@jarvis/jarvis-columns-shell.html.twig' with { count: 1 } %}
  {% block columns %}
    <div class="col-12">
      {{ first }}
    </div>
  {% endblock %}
{% endembed %}
