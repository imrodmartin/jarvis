{#
/**
 * @file
 * Jarvis Video with Sidebar SDC. A responsive video beside an eyebrow / title /
 * description / CTA buttons column. The video source is either a media-library
 * pick (video.src) or a plain URL (video_url) — the latter is how a Views row
 * template feeds it. YouTube/Vimeo watch URLs are normalised to embed URLs.
 */
#}
{% import '@jarvis/jarvis-spacing.html.twig' as jarvis %}
{% import '@jarvis/jarvis-url.html.twig' as safe %}
{% set space = jarvis.classes(padding|default('none'), padding_size|default('medium'), margin|default('none'), margin_size|default('medium'), (vertical_padding is defined ? vertical_padding : false)) %}
{% set h = heading_level|default('h2') ?: 'h2' %}
{% set aspect = aspect|default('16x9') %}
{% set ratio_class = { '16x9': 'ratio-16x9', '4x3': 'ratio-4x3', '21x9': 'ratio-21x9' }[aspect] %}
{# Shared with the video component — see @jarvis/jarvis-video.html.twig. #}
{% import '@jarvis/jarvis-video.html.twig' as video_url_helper %}
{# A Remote video media pick becomes the iframe; video_url is files only.
   Splitting them is what keeps an arbitrary origin out of the iframe: a hosted
   player can only arrive through the media library, so the src is always a URL
   core's oEmbed provider registry already accepted. A player URL pasted into
   video_url is not a file, so it renders nothing.
   video_media arrives as the media item's oEmbed URL STRING, not an entity —
   JarvisCanvasHooks::canvasStorablePropShapeAlter() builds the expression that
   reads it off field_media_oembed_video. #}
{% set media_url = safe.url(video_media|default('')) %}
{% set file_url = safe.url(video_url|default('')) %}
{% set file_url = video_url_helper.is_file(file_url) is not empty ? file_url : '' %}
{% set embed_url = media_url ? video_url_helper.embed_url(media_url) : '' %}
{% set captions_url = safe.url(captions_url|default('')) %}
{% set button1_href = safe.url(button1_href|default('')) %}
{% set button2_href = safe.url(button2_href|default('')) %}
<div class="jarvis-video-sidebar {{ space }}">
  <div class="row g-0 align-items-center {{ video_right|default(false) ? 'flex-lg-row-reverse jarvis-video-sidebar--right' : '' }}">
    <div class="col-12 col-lg-7 jarvis-video-sidebar__media">
      {% if embed_url or file_url %}
        <div class="ratio {{ ratio_class }}">
          {% if embed_url %}
            {# The player needs scripts and its own origin's storage; nothing here
               needs to navigate the top frame, open windows, submit forms or start
               downloads, which is what an unsandboxed embed inherits. `autoplay` is
               not in `allow` — the embed URL never carries autoplay=1, and the
               autoplay prop drives the native <video> path only. #}
            <iframe src="{{ embed_url }}" title="{{ title|default('Video'|t) }}" sandbox="allow-scripts allow-same-origin allow-presentation" allow="fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
          {% else %}
            {# Reachable only when video_url points at a file. Remote video carries
               its own thumbnail, so there is no poster prop. #}
            <video controls preload="metadata">
              <source src="{{ file_url }}">
              {# ADA (WCAG 1.2.2): captions track for the native player, same as the
                 video component. Hosted embeds carry their own captions. #}
              {% if captions_url %}<track kind="captions" src="{{ captions_url }}" srclang="{{ captions_lang|default('en') }}" label="{{ 'Captions'|t }}" default>{% endif %}
            </video>
          {% endif %}
        </div>
      {% endif %}
    </div>
    <div class="col-12 col-lg-5 jarvis-video-sidebar__aside">
      {% if eyebrow %}<p class="jarvis-video-sidebar__eyebrow text-uppercase fw-bold mb-2">{{ eyebrow }}</p>{% endif %}
      {% if title %}<{{ h }} class="jarvis-video-sidebar__title fw-bold mb-3">{{ title }}</{{ h }}>{% endif %}
      {% if description %}<div class="jarvis-video-sidebar__desc mb-4">{{ description }}</div>{% endif %}
      {% if (button1_text and button1_href) or (button2_text and button2_href) %}
        <div class="jarvis-video-sidebar__actions d-flex flex-wrap align-items-center gap-3">
          {% if button1_text and button1_href %}<a href="{{ button1_href }}" class="btn btn-primary btn-lg">{{ button1_text }}</a>{% endif %}
          {% if button2_text and button2_href %}<a href="{{ button2_href }}" class="jarvis-video-sidebar__link fw-bold">{{ button2_text }} <span aria-hidden="true">&rarr;</span></a>{% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>
