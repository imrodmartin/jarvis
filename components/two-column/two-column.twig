{#
/**
 * @file
 * Jarvis 2-column layout. col-12 on mobile -> stacks; col-md-* -> side by side.
 *
 * Wrapper, background resolution, ADA text-colour matrix and overlay live in
 * the shared shell — see @jarvis/jarvis-columns-shell.html.twig.
 */
#}
{% set cols = {
  even: ['col-12 col-md-6', 'col-12 col-md-6'],
  'wide-left': ['col-12 col-md-8', 'col-12 col-md-4'],
  'wide-right': ['col-12 col-md-4', 'col-12 col-md-8'],
  'wide-left-75': ['col-12 col-md-9', 'col-12 col-md-3'],
  'wide-right-75': ['col-12 col-md-3', 'col-12 col-md-9'],
}[ratio|default('even')] %}
{% embed '@jarvis/jarvis-columns-shell.html.twig' with { count: 2 } %}
  {% block columns %}
    <div class="{{ cols[0] }}">
      {{ first }}
    </div>
    <div class="{{ cols[1] }}">
      {{ second }}
    </div>
  {% endblock %}
{% endembed %}
