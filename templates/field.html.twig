{#
/**
 * @file
 * Jarvis field wrapper.
 *
 * With `base theme: false` Drupal falls back to core's bare field template,
 * which prints no classes, so the field formatter's "Label: Inline" setting
 * (in Manage display and on Canvas's field component) had nothing to style.
 * This adds the standard field / field__label / field__item classes plus
 * field--label-{above|inline|visually_hidden}; css/fields.css lays them out.
 */
#}
{% set classes = [
  'field',
  'field--name-' ~ field_name|clean_class,
  'field--type-' ~ field_type|clean_class,
  'field--label-' ~ label_display,
] %}
{% set title_classes = [
  'field__label',
  label_display == 'visually_hidden' ? 'visually-hidden',
] %}
{% if label_hidden %}
  {% if multiple %}
    <div{{ attributes.addClass(classes, 'field__items') }}>
      {% for item in items %}
        <div{{ item.attributes.addClass('field__item') }}>{{ item.content }}</div>
      {% endfor %}
    </div>
  {% else %}
    {% for item in items %}
      <div{{ attributes.addClass(classes, 'field__item') }}>{{ item.content }}</div>
    {% endfor %}
  {% endif %}
{% else %}
  <div{{ attributes.addClass(classes) }}>
    <div{{ title_attributes.addClass(title_classes) }}>{{ label }}</div>
    {% if multiple %}<div class="field__items">{% endif %}
    {% for item in items %}
      <div{{ item.attributes.addClass('field__item') }}>{{ item.content }}</div>
    {% endfor %}
    {% if multiple %}</div>{% endif %}
  </div>
{% endif %}
